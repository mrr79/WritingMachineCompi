    SEMICOLON       reduce using rule 55 (sum -> SUMO PAR_OPEN n3 COLON n2 PAR_CLOSE SEMICOLON .)
    COLON           reduce using rule 55 (sum -> SUMO PAR_OPEN n3 COLON n2 PAR_CLOSE SEMICOLON .)
    PAR_CLOSE       reduce using rule 55 (sum -> SUMO PAR_OPEN n3 COLON n2 PAR_CLOSE SEMICOLON .)

